# Leave DATABASE_URL empty for durable, single-process local PGlite PostgreSQL.
# Set a real PostgreSQL URL for deployment, run npm run db:migrate, then db:seed.
DATABASE_URL=
# Demonstration checkout uses sample connected methods and never charges money.
# Defaults on with npm run dev; explicitly set false for real sandbox-only operation.
DEMO_MODE=true
LOCAL_DATABASE_PATH=.data/marketplace.pglite
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEED_DEMO=true
# Set a strong password before running db:seed; never enable demo seed in production.
DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Stripe test keys only. Live keys are intentionally rejected in this release.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
JOBS_SECRET=
